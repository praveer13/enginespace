{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.pure.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "types": [],
    "skipLibCheck": true,

    /* Pure code reaches the other packages and nothing in src/ (A§2.3). */
    "paths": {
      "@es/sim": ["./packages/sim"],
      "@es/sim/*": ["./packages/sim/*"],
      "@es/play": ["./packages/play"],
      "@es/play/*": ["./packages/play/*"],
      "@es/ledger": ["./packages/ledger"],
      "@es/ledger/*": ["./packages/ledger/*"],
      "@es/schema": ["./packages/schema"],
      "@es/schema/*": ["./packages/schema/*"],
      "@es/verify": ["./packages/verify"],
      "@es/verify/*": ["./packages/verify/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["packages/sim", "packages/play"]
}
